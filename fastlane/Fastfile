    def run_tests_frameworks(schemas, options)
        xcodes(select_for_current_build_only: true)
        # hardcoded values that are required - not meaningful for testing
        options[:build_type] = "Development"
        options[:build_number] = 1
        build = Build.new(options: options)

        write_tests_info_to_summary("🤖 Testing schemas: #{schemas.join(', ')}")

        testplan = options[:testplan] || "AllTests" # TODO: [WPB-17497] GermanLocaleTests are not run

        is_nightly_build = options[:all] == true

        schema_errors = {}

        schemas.each do |scheme|
            write_tests_info_to_summary("🤖 Testing scheme #{scheme} with plan #{testplan}")
            begin
                test_plan(build, scheme, testplan, options)
                schema_errors[scheme] = false
            rescue => e
                write_tests_info_to_summary("❌ Scheme: #{scheme} failed with errors: #{e.to_s}")
                if !is_nightly_build
                    raise e
                end
                schema_errors[scheme] = true
            end
        end

        # report errors so Github action fails
        if schema_errors.values.include?(true)
            raise "Tests fail"
        end
    end

 
    def build_and_upload_app(options)
        xcodes(select_for_current_build_only: true)
        options[:build_number] = generate_build_number
        prepare_for_release(options)
        build = Build.new(options: options)
        write_build_info_to_summary(build)
        if !build.skip_security_tests
            UI.message "🤖 Run security tests"
            create_simulator_if_needed
            security_plans(options)
        end

        if options[:produce_debug_builds] || false
            UI.message "🤖 Build for simulator"
            build_for_release(options.merge({:configuration => "Debug", :for_simulator => true}))
        end

        produce_release_builds = options[:skip_release_builds].nil? || options[:skip_release_builds] != true
        if produce_release_builds
            UI.message "🤖 Build for release"
            build_for_release(options)
        end

        UI.message "🤖 Upload"
        if options[:upload_app_store] || false
            upload_app_store(options)
        end
        if options[:upload_testflight] || false
            upload_testflight(options)
        end
        sha256(options)
        upload_s3(options)
        save_changelog_to_env(options)
    end

    def save_app_name(name)
        `echo APP_NAME=#{name} >> ./.post_build/.env`
    end

    def download_distribution_certificate_and_profiles(build, options)
        if is_running_on_ci 
            match(
                git_url: "https://#{ENV['WIRE_INTERNAL_GITHUB_USER']}:#{ENV['WIRE_INTERNAL_GITHUB_TOKEN']}@github.com/wireapp/wire-ios-certificates.git",
                readonly: true,
                type: "appstore",
                skip_provisioning_profiles: true,
                app_identifier: []
            )
        else
            match(
                readonly: true,
                type: "appstore",
                skip_provisioning_profiles: true,
                app_identifier: []
            )
        end

        app_bundle_id = get_xcconfig_value(
            path: './wire-ios/Configuration/Release.xcconfig',
            name: 'WIRE_BUNDLE_ID'
        )

        UI.message("downloading provisioning profiles for bundle id: #{app_bundle_id}")
        
        sigh(
            adhoc: build.should_sigh_adhoc,
            readonly: true,
            api_key_path: appstoreconnect_api_key_file_path,
            app_identifier: app_bundle_id
        )
        sigh(
            adhoc: build.should_sigh_adhoc,
            readonly: true,
            api_key_path: appstoreconnect_api_key_file_path,
            app_identifier: "#{app_bundle_id}.extension-share"
        )
        sigh(
            adhoc: build.should_sigh_adhoc,
            readonly: true,
            api_key_path: appstoreconnect_api_key_file_path,
            app_identifier: "#{app_bundle_id}.extension-notification"
        )
    end

    def generate_build_number
        build_number = `curl -H "Accept: text/plain" -X POST -d '' "https://incrementator.appspot.com/api/v1/code/ORUHILeMbXB4D5Z5conFzYoYpQPjVnyUA4pu56X2MHVJSFxM/increment"`
        `echo BUILD_NUMBER=#{build_number} >> ./.post_build/.env`
        build_number
    end

    def write_build_info_to_summary(build)
        summary_file = ENV['GITHUB_STEP_SUMMARY']

        if summary_file.nil? || summary_file.empty?
          UI.error("GITHUB_STEP_SUMMARY is not set. Are you running in GitHub Actions?")
          return
        end

        File.open(summary_file, "a") do |file|
          file.puts "## Fastlane Summary"
          file.puts "- 🛠️ Version: '#{build.extra_info}'"
        end
      
        UI.message("Successfully wrote to GITHUB_STEP_SUMMARY.")
    end

    def write_tests_info_to_summary(text)
        if is_running_on_ci
            summary_file = ENV['GITHUB_STEP_SUMMARY']
        else
            summary_file = "github_summary.md"
        end

        if (summary_file.nil? || summary_file.empty?)
          UI.error("GITHUB_STEP_SUMMARY is not set. Are you running in GitHub Actions?")
          return
        end

        UI.message(text)
        File.open(summary_file, "a") do |file|
          file.puts "#{text}"
        end
    end

    # Fetch dependencies and prepare for building a release
    def prepare_for_release(options)
        build_type = options[:build_type]
        # Delete configurations in case we switch to different branch or repo
        sh "rm -rf ../Configuration"
        if build_type.nil? 
            sh "cd .. && ./setup.sh"
        else
            override_folder = options[:override_folder]
            if override_folder.nil? 
                override_folder = "Cloud"
            end

            build = Build.new(options: options)

            `echo BUILD_VERSION=#{build.version_from_xcconfig} >> ./.post_build/.env`

            sh "cd .. && ./setup.sh -o \'./wire-ios-build-assets/#{override_folder}/#{build_type}\'"
            # Adding extra information to the icon must be done after we check them out in setup script
            build.process_icon()

            download_distribution_certificate_and_profiles(build, options)
        end
    end

    # Build for release to AppStore or App Center/S3
    def build_for_release(options)
        build = Build.new(options: options)
        export_method = options[:export_method] || build.export_method

        if build.for_simulator
            Dir.chdir("..") do
                # Build the app for simulator
                sh "xcodebuild " \
                   "-workspace 'wire-ios-mono.xcworkspace' " \
                   "-scheme 'Wire-iOS' " \
                   "-configuration 'Debug' " \
                   "-destination \"generic/platform=iOS Simulator\" " \
                   "-derivedDataPath DerivedData " \
                   "-quiet build " \
                   "BUILD_NUMBER=#{build.build_number}"

                # make a "fake" .ipa package that QA will use for installing to simulator
                sh "mkdir -p debug/Payload"
                sh "mkdir -p #{build.artifact_path(with_filename: false)}"
                sh "cp -r DerivedData/Build/Products/Debug-iphonesimulator/*.app debug/Payload/"
                sh "cd debug && zip -r ../#{build.artifact_path(with_filename: true)}.ipa Payload/"
            end
        else
            enable_countly_args = [
                "COUNTLY_APP_KEY=#{build.countly_api_key}",
            ]

            # DataDog values needs to go through WireCommonComponents
            enable_datadog_args = [
                "DATADOG_APP_ID=#{ENV['DATADOG_APP_ID']}",
                "DATADOG_CLIENT_TOKEN=#{ENV['DATADOG_CLIENT_TOKEN']}",
            ]

            xcargs = ["BUILD_NUMBER=#{build.build_number}"]
            xcargs += enable_datadog_args if build.enable_datadog
            xcargs += enable_countly_args if build.enable_countly

            sh "echo $HAS_PACKAGES_CACHE_HIT"
            build_app(
                scheme: "Wire-iOS",
                configuration: build.configuration,
                export_method: export_method,
                export_options: {"iCloudContainerEnvironment": "Production"},
                derived_data_path: "DerivedData",
                suppress_xcode_output: true,
                silent: true,
                archive_path: build.archive_path(with_filename: true),
                buildlog_path: build.build_path,
                output_directory: build.artifact_path(with_filename: false),
                output_name: build.filename,
                include_bitcode: false,
                include_symbols: true,
                xcargs: xcargs.join(' '),
                cloned_source_packages_path: ENV['PACKAGES_DIR'],
                disable_package_automatic_updates: true,
                skip_package_dependencies_resolution: ENV["HAS_PACKAGES_CACHE_HIT"]
            )
        end
    end

    # Run security plans
    def security_plans(options)
        build = Build.new(options: options)
      
        for scheme in ["Wire-iOS", "WireDataModel", "WireSyncEngine"] do
            test_plan(build, scheme, "SecurityTests")
        end
    end

    def test_plan(build, scheme, testplan, options = {})
        if ENV['IOS_SIM_ID'].nil?
            create_simulator_if_needed
        end

        if ENV['IOS_SIM_ID'].nil?
            UI.user_error! "missing id for tests"
        end

        ENV['TEST_RUNNER_CI'] = ENV['CI']

        run_tests_options = {
            step_name: "🧪 Running tests for scheme: #{scheme}",
            testplan: testplan,
            scheme: scheme,
            skip_detect_devices: true,
            configuration: "Debug",
            sdk: "iphonesimulator",
            destination: "platform=iOS Simulator,id=#{ENV['IOS_SIM_ID']},OS=#{ios_version}",
            # code_coverage: true,
            derived_data_path: "DerivedData",
            buildlog_path: build.build_path,
            result_bundle: true,
            # suppress_xcode_output: true,
            output_directory: "#{build.artifact_path(with_filename: false)}/tests/#{scheme}",
            output_types: "junit",
            cloned_source_packages_path: ENV['PACKAGES_DIR'],
            disable_package_automatic_updates: true,
            skip_package_dependencies_resolution: true,
            number_of_retries: build.number_of_retries,
            output_remove_retry_attempts: options[:output_remove_retry_attempts].to_s == "true",
            xcargs: "-collect-test-diagnostics never" # Disable verbose diagnostics as these are generally not useful and collecting them can cause 600 second delays per test scheme.
        }
        only_testing = normalize_test_identifiers(options[:only_testing])
        skip_testing = normalize_test_identifiers(options[:skip_testing])
        run_tests_options[:only_testing] = only_testing if only_testing.any?
        run_tests_options[:skip_testing] = skip_testing if skip_testing.any?

        run_tests(run_tests_options)
    end

    def normalize_test_identifiers(value)
        Array(value)
            .flat_map { |identifier| identifier.to_s.split(/[\s,]+/) }
            .map(&:strip)
            .reject(&:empty?)
            .uniq
    end

    def normalize_testiny_case_ids(value)
        Array(value)
            .flat_map { |id| id.to_s.split(/[\s,]+/) }
            .map { |id| id.gsub(/\ATC[-_]?/i, "").strip }
            .select { |id| id.match?(/\A\d+\z/) }
            .uniq
    end

    def testiny_ids_from_test_identifier(identifier)
        name = identifier.split("/").last
        match = name.match(/_TC_+(.*)\z/i)
        return [] unless match

        match[1].split("_").take_while { |part| part.match?(/\A\d+\z/) }.uniq
    end

    def ui_test_identifiers_matching_testiny_cases(value)
        requested_ids = Array(value)
        return [] if requested_ids.empty?

        matching_tests = ui_test_metadata.select do |test|
            (requested_ids & testiny_ids_from_test_identifier(test[:identifier])).any?
        end
        matched_ids = matching_tests.flat_map { |test| testiny_ids_from_test_identifier(test[:identifier]) }.uniq
        missing_ids = requested_ids - matched_ids
        UI.message("Ignoring unmatched Testiny case id(s): #{missing_ids.join(',')}") if missing_ids.any?

        matching_tests.map { |test| test[:identifier] }.uniq
    end

    def ui_test_identifiers_matching_selectors(value)
        tokens = normalize_test_identifiers(value)
        return [] if tokens.empty?

        tests = ui_test_metadata
        matching_tests = []
        missing_tokens = []

        tokens.each do |token|
            token_matches = ui_test_tests_matching_token(token, tests)
            if token_matches.empty?
                missing_tokens << token
            else
                matching_tests.concat(token_matches)
            end
        end

        UI.message("Ignoring unmatched UI test selector(s): #{missing_tokens.join(',')}") if missing_tokens.any?
        matching_tests.map { |test| test[:identifier] }.uniq
    end

    def ui_test_tests_matching_token(token, tests)
        requested_ids = normalize_testiny_case_ids(token)
        return tests.select { |test|
            (requested_ids & testiny_ids_from_test_identifier(test[:identifier])).any?
        } if requested_ids.any?

        test_identifier = token.delete_prefix("WireUITests/")
        parts = test_identifier.split("/")

        tests.select do |test|
            _, class_name, method_name = test[:identifier].split("/")
            case parts.length
            when 1
                parts[0].start_with?("test") ? method_name == parts[0] : class_name == parts[0]
            when 2
                class_name == parts[0] && method_name == parts[1]
            else
                test[:identifier] == token
            end
        end
    end

    def ui_test_filter_options(options)
        excluded_tags = excluded_ui_test_tags(options[:tags])
        if excluded_tags.any?
            skipped_tests = ui_test_tests_matching_any_tag(excluded_tags)
            identifiers = skipped_tests.map { |test| test[:identifier] }
            UI.message("Running UI tests excluding tags: #{excluded_tags.map { |tag| "!#{tag}" }.join(',')}")
            return identifiers.empty? ? {} : { skip_testing: identifiers }
        end

        tag_groups = parse_ui_test_tag_expression(options[:tags])
        return {} if tag_groups.empty?

        tag_expression = format_ui_test_tag_expression(tag_groups)
        selected_tests = ui_test_tests_matching_tag_groups(tag_groups: tag_groups)
        UI.user_error!("No UI tests matched tags: #{tag_expression}") if selected_tests.empty?

        identifiers = selected_tests.map { |test| test[:identifier] }
        UI.message("Running #{identifiers.count} UI tests matching tags: #{tag_expression}")
        { only_testing: identifiers }
    end

    def ui_test_tests_matching_tag_groups(tag_groups:, excluded_tags: [])
        blocked_tags = excluded_tags.to_set

        ui_test_metadata.select do |test|
            test_tags = test[:tags].to_set
            tag_groups.all? { |group| group.any? { |tag| test_tags.include?(tag) } } &&
                (blocked_tags & test_tags).empty?
        end
    end

    def ui_test_tests_matching_any_tag(tags)
        requested_tags = tags.to_set

        ui_test_metadata.select do |test|
            (requested_tags & test[:tags].to_set).any?
        end
    end

    def ui_test_metadata
        test_root = File.expand_path("../wire-ios/WireUITests", __dir__)

        Dir.glob(File.join(test_root, "**/*.swift")).sort.flat_map do |file|
            ui_test_metadata_for_file(file)
        end
    end

    def ui_test_metadata_for_file(file)
        current_class = nil
        class_tags = []
        pending_tags = []
        tests = []

        File.readlines(file).each_with_index do |line, index|
            marker_tags = parse_ui_test_marker_tags(line)
            if marker_tags.any?
                pending_tags = (pending_tags + marker_tags).uniq
                next
            end

            stripped_line = line.strip
            if stripped_line.empty? || stripped_line.start_with?("//")
                pending_tags = []
                next
            end

            next if stripped_line.start_with?("@")

            if (class_match = line.match(/\b(?:final\s+)?class\s+(\w+)\s*:\s*WireUITestCase\b/))
                current_class = class_match[1]
                class_tags = pending_tags
                pending_tags = []
                next
            end

            if current_class && !line.match?(/\bprivate\s+func\b/) &&
               (test_match = line.match(/\bfunc\s+(test\w*)\s*\(\s*\)/))
                method_name = test_match[1]
                tags = (class_tags + pending_tags).uniq
                tests << {
                    identifier: "WireUITests/#{current_class}/#{method_name}",
                    tags: tags,
                    file: file,
                    line: index + 1
                }
            end

            pending_tags = []
        end

        tests
    end

    def parse_ui_test_marker_tags(line)
        match = line.match(/\A\s*\/\/\/\s*\[\s*([a-zA-Z][a-zA-Z0-9_-]*(?:\s*,\s*[a-zA-Z][a-zA-Z0-9_-]*)*)\s*\]\s*\z/)
        return [] unless match

        normalize_ui_test_tags(match[1])
    end

    def parse_ui_test_tag_expression(value)
        Array(value)
            .flat_map { |tag_expression| tag_expression.to_s.split(",") }
            .map { |group| normalize_ui_test_tags(group.split("|")) }
            .reject(&:empty?)
    end

    def excluded_ui_test_tags(value)
        tags = Array(value)
            .flat_map { |tag_expression| tag_expression.to_s.split(",") }
            .flat_map { |group| group.split("|") }
            .map { |tag| tag.strip.downcase }
            .reject(&:empty?)

        excluded_tags = tags.select { |tag| tag.start_with?("!") }
        return [] if excluded_tags.empty?

        UI.user_error!("Exclude UI test tags cannot be combined with included tags") if excluded_tags.count != tags.count

        normalize_ui_test_tags(excluded_tags.map { |tag| tag.delete_prefix("!") })
    end

    def format_ui_test_tag_expression(tag_groups)
        tag_groups.map { |group| group.join("|") }.join(",")
    end

    def normalize_ui_test_tags(value)
        Array(value)
            .flat_map { |tag| tag.to_s.split(",") }
            .map { |tag| tag.strip.downcase }
            .reject(&:empty?)
            .uniq
    end

    def create_simulator_if_needed
        devices = `xcrun simctl list`
        UI.message("Available simulators:\n#{devices}")

        # Check if the simulator already exists
        existing_simulator = `xcrun simctl list devices | grep "#{iPhoneNameForTesting}" | grep "iOS#{ios_version}" | awk -F '[()]' '{print $2}'`.chomp

        if existing_simulator.empty?
            UI.message "create simulator #{iPhoneNameForTesting} - iOS#{ios_version}"
            existing_simulator = `xcrun simctl create "#{iPhoneNameForTesting} - iOS#{ios_version}" "#{iPhoneNameForTesting}" "iOS#{ios_version}"`
        else
            UI.message "clear simulator content for #{existing_simulator}"
            `xcrun simctl erase #{existing_simulator}`
        end
        ENV['IOS_SIM_ID'] = existing_simulator.strip

        if ENV['GITHUB_ENV']
            sh "echo IOS_SIM_ID=#{ENV['IOS_SIM_ID']} >> #{ENV['GITHUB_ENV']}"
        end
        sh "../scripts/seed-simulator-media.sh"
    end
    
    # Upload to AppStore
    def upload_app_store(options)
        build = Build.new(options: options)
        sh "cp ../wire-ios/Configuration/Appfile ."

        deliver(
            api_key_path: appstoreconnect_api_key_file_path,
            ipa: "#{build.artifact_path(with_filename: true)}.ipa",
            submit_for_review: false,
            automatic_release: false,
            force: true, # Skip HTML report verification
            skip_binary_upload: false,
            run_precheck_before_submit: false,
            precheck_include_in_app_purchases: false,
            skip_app_version_update: true,
            skip_metadata: true,
            skip_screenshots: true
        )
    end

    # Upload to TestFlight
    def upload_testflight(options)
        build = Build.new(options: options)
        sh "cp ../wire-ios/Configuration/Appfile ."
        
        # we add this group to get a review from Apple when we upload new build version
        # in order to speed up distribution to real external groups
        groups = ["Default External Testers"]
        if build.send_to_externals
            groups += options[:extra_distribution_groups]
        end

        begin
            upload_to_testflight(
                api_key_path: appstoreconnect_api_key_file_path,
                ipa: "#{build.artifact_path(with_filename: true)}.ipa",
                skip_waiting_for_build_processing: false,
                distribute_external: true,
                groups: groups,
                submit_beta_review: true,
                changelog: changelog(build)
            )
        rescue Spaceship::UnexpectedResponse => e
            UI.error("TestFlight upload skipped: #{e.message}")
            export_env_path = "./.post_build/.env"
            FileUtils.mkdir_p("./.post_build")
            error_line = e.message.tr("\n", ' ').strip.gsub('"', '\\"')
            File.open(export_env_path, 'a') { |f| f.puts "TESTFLIGHT_ERROR=\"#{error_line}\"" }
        end
    end

    # Changelog for current build
    def changelog(build)
        changelog = ""
        changelog_path = './../CHANGELOG.md'

        if build.playground_build 
            changelog += "Playground build for #{build.git_branch}\n\n"
        end

        if !build.development_build && File.exist?(changelog_path)
            changelog += File.read(changelog_path)
        else 
            changelog += "**Last commits:**\n" + changelog_from_git_commits(
                    commits_count: 5,
                    pretty: "- %s by %ae",
            )
        end
        changelog
    end

    # "Calculate sha256 ipa"
    def sha256(options)
        build = Build.new(options: options)
       
        # Calculate SHA-256 for the local IPA file
        ipa_path = "../#{build.artifact_path(with_filename: true)}.ipa"
        sha256 = `shasum -a 256 #{ipa_path} | awk '{print $1}'`.strip
        UI.message("SHA-256 of IPA is: #{sha256}")

        # Export SHA-256 and INSTALL_LINK to .post_build/.env file
        export_env_path = "./.post_build/.env"
        FileUtils.mkdir_p("./.post_build")

        sh "export TEMP='BUILD_SHA256=#{sha256}' && echo $TEMP >> #{export_env_path}"
    end

    # Upload to S3 (Automation builds)
    def upload_s3(options)
        build = Build.new(options: options)
        s3_subfolder = options[:s3_subfolder]

        if s3_subfolder.nil? 
            s3_path = "s3://#{ENV['S3_BUCKET']}/ios/"
            sh "echo upload to s3 default folder "
        else 
            s3_path = "s3://#{ENV['S3_BUCKET']}/ios/#{s3_subfolder}/"
            sh "echo upload to s3 subfolder: #{s3_subfolder}"
        end


        output = ""
        if build.appstore_build
            output += `cd ../#{build.archive_path(with_filename: false)} && tar -czf #{build.filename}.xcarchive.tgz #{build.filename}.xcarchive`
        end
        
        output += `cd .. && aws s3 cp --recursive --exclude '*'  --include '*.ipa'  --include '*.app.dSYM.zip' --include '*.xcarchive.tgz' --include '*.junit' artifacts/ #{s3_path}`
        paths = output.split(/[\r,\n]/).map { |line| line.gsub(/\n/, '').gsub(/\*/, '').match(/s3:\/\/.*ipa$/)}.compact!.map{ |match| match[0] }.uniq.join(' ')
        `export TEMP='S3_PATHS=#{Base64.strict_encode64(paths)}' && echo $TEMP >> ./.post_build/.env`
    end

    def save_changelog_to_env(options)
        build = Build.new(options: options)
        changelog = changelog(build)
        `export TEMP='RELEASE_NOTES=#{Base64.strict_encode64(changelog)}' && echo $TEMP >> ./.post_build/.env`
    end
end

class Build
    attr_reader :build_type
    attr_reader :git_branch
    attr_reader :build_number
    attr_reader :for_simulator
    attr_reader :configuration
    attr_reader :enable_datadog
    attr_reader :skip_security_tests
    # send to non-default external distribution list
    attr_reader :send_to_externals
    attr_reader :countly_api_key
    attr_reader :enable_countly
    attr_reader :number_of_retries
    
    def initialize(options:)
        build_number = options[:build_number]
        if build_number.nil?
            UI.user_error! "Pass build_number parameter to fastlane e.g. fastlane build build_number:1234"
        end
        build_type = options[:build_type]
        if build_type.nil? 
            UI.user_error! "Pass build_type parameter, e.g. fastlane build build_type:Development"
        end


        @build_type = build_type
        if ENV['GITHUB_REF_NAME'].nil? 
            @git_branch = %x(git rev-parse --abbrev-ref HEAD).chomp
        else
            @git_branch = ENV['GITHUB_REF_NAME']
        end

        @countly_api_key = options[:countly_api_key]
        @enable_countly = ENV['ENABLE_COUNTLY'] == "true" || ENV['ENABLE_COUNTLY'] == "1"
        @send_to_externals = ENV['SEND_TO_EXTERNALS'] == "true" || ENV['SEND_TO_EXTERNALS'] == "1"
        @enable_datadog = ENV['ENABLE_DATADOG'] == "true" || ENV['ENABLE_DATADOG'] == "1"
        @skip_security_tests = ENV['SKIP_SECURITY_TESTS'] == "true" || ENV['SKIP_SECURITY_TESTS'] == "1"
        @build_number = build_number
        @number_of_retries = options[:number_of_retries] || 2
        
        for_simulator = options[:for_simulator]
        if for_simulator.nil? 
            @for_simulator = false
        else
            @for_simulator = for_simulator.to_s == 'true'
        end

        configuration = options[:configuration]
        if configuration.nil? 
            @configuration = "Release"
        else
            @configuration = configuration
        end
        
    end

    # Helpers

    def pr_build?
        !ENV['PR_S3_SUBFOLDER'].nil? 
    end

    def playground_build
        @build_type == "Playground"
    end

    def appstore_build
        @build_type == "AppStore"
    end

    def development_build
        @build_type == "Development"
    end

    def rc_build
        @build_type == "RC"
    end

    def beta_build
        @build_type == "Beta"
    end

    def debug_build
        @configuration == "Debug"
    end

    def normalized_branch_name
        @git_branch.gsub("/", "_")
    end

    def export_method
        if debug_build
            "development"
        elsif appstore_build || beta_build || rc_build || playground_build || development_build
            "app-store"
        else 
            "ad-hoc"
        end
    end

    def should_sigh_adhoc
        !appstore_build && !rc_build && !beta_build && !playground_build && !development_build
    end

    # Paths

    def artifact_path(with_filename: true)
        "artifacts/#{artifact_directory}" + (with_filename ? "/#{filename}" : "")
    end

    def build_path
        "build"
    end

    def archive_path(with_filename: true)
        # Put AppStore archive next to .ipa for futher processing
        if appstore_build
            "artifacts/#{artifact_directory}" + (with_filename ? "/#{filename}" : "")
        else 
            "#{build_path}" + (with_filename ? "/#{filename}" : "")
        end
    end

    def filename
        simulator = @for_simulator ? "-simulator" : ""
        "Wire-#{@build_type.downcase}-#{normalized_branch_name}#{simulator}-#{@build_number}"
    end

    def artifact_directory
        result = ""
        suffix = "" 
        if for_simulator 
            suffix = "simulator" 
        else 
            suffix = "device/" + (debug_build ? "debug" : "release")
        end

        case @build_type
        when "Playground"
            result = "playground-#{normalized_branch_name}/#{suffix}"
        when "Development"
            result = "development/#{suffix}"
        when "AppStore"
            result = "release/appstore"
        when "RC"
            result = "release/#{suffix}"
        when "Beta"
            result = "release/testflight"
        else
            UI.user_error! "Unknown build type: #{@build_type}"
        end

        # We want to group related artifacts by the filename.
        if !pr_build?
            result + "/" + filename
        else
            result + "/PR/" + ENV['PR_S3_SUBFOLDER']
        end
    end

    # Adding build number to icon

    def process_icon
        # No preprocessing needed for AppStore icons
        if appstore_build
            return
        end
        # Loop over all icons in the iconset
        processed = 0
        Dir.glob("../wire-ios/#{iconset_location}/*.png") do |image|
            width = %x( identify -format %w #{image} )
            image_height = %x( identify -format %h #{image} )
            height = Integer(image_height) / 4.0

            # Add build number to the icon
            %x( magick -background '#0008' -fill white -font '/System/Library/Fonts/Helvetica.ttc' -gravity center -size #{width}x#{height} caption:"#{extra_info}" "#{image}" +swap -gravity south -composite "#{image}" )
            processed += 1
        end
        UI.important("Processed #{processed} icons in #{iconset_location} by adding '#{extra_info}'")
    end

    def extra_info
        prefix = ""
        if rc_build
            prefix = "#{version_from_xcconfig}-"
        end

        prefix + @build_number
    end

    def version_from_xcconfig
        IO.foreach('../wire-ios/Wire-iOS/Resources/Configuration/Version.xcconfig').grep(/WIRE_SHORT_VERSION/).first.split(" = ")[1].chomp
    end

    def iconset_location
        "Configuration/Images.xcassets/AppIcon-#{iconset_name}.appiconset"
    end

    def iconset_name
        if debug_build
            "Development" # yellow
        elsif development_build
            "Edge"
        elsif playground_build
            "Development" # yellow
        elsif rc_build
            "Release"
        else
            @build_type
        end
    end
end
