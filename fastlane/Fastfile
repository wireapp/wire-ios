    def iPhoneNameForTesting
        ENV['IPHONE_MODEL']
    end
  
    def ios_version
        ENV['IOS_VERSION']
    end

    def appstoreconnect_api_key_file_path 
        './fastlane/appstoreconnect_api_key.json'
    end

    def is_running_on_ci 
        !ENV['CI'].nil?
    end

    def create_keychain_if_needed
        create_keychain(
            default_keychain: false,
            unlock: true,
            timeout: 3600,
            lock_when_sleeps: true
        ) if is_running_on_ci
    end

    def delete_keychain_if_needed
        return unless is_running_on_ci
        begin
            delete_keychain
        rescue
            UI.verbose("No keychain found, skipping deletion...")
        end
    end

    before_all do |lane|
        create_keychain_if_needed unless [:prepare_for_tests, :select_framework, :select_frameworks, :generate_framework_list, :list_schemes_json, :test_frameworks, :test_only_frameworks, :run_uitests, :generate_env].include?(lane)
        `mkdir -p ./.post_build`
        Dir.chdir("..") do
            encoded_key = ENV['APPSTORE_API_KEY_BASE64']
            if !File.exist?(appstoreconnect_api_key_file_path) && !encoded_key.nil?
                UI.message("Setting AppStoreConnect API Key")
                File.open(appstoreconnect_api_key_file_path, 'w+') {|f| f.write(Base64.decode64(encoded_key)) }
            end
        end
    end

    after_all do |lane|
        delete_keychain_if_needed unless [:prepare_for_tests, :select_framework, :select_frameworks, :generate_framework_list, :list_schemes_json, :test_frameworks, :test_only_frameworks, :run_uitests].include?(lane)
    end
    
    desc "Test frameworks given folders"
    lane :test_frameworks do |options|
        if options[:all]
            schemas = Framework.all.values.map { |f| f.scheme }
        else
            if (options[:folders].nil? || options[:folders].empty?) && !is_running_on_ci
                schemas = select_frameworks()
            else 
                schemas = generate_framework_schemes(folders: options[:folders])
            end
        end
       
       UI.message "🤖 No schemes to test" if schemas.empty?
       
       begin
           run_tests_frameworks(schemas, options)
       rescue => e
           UI.test_failure!("Failing running tests #{e.to_s}")
       end
    end

    desc "Test Frameworks without dependencies given folders"
    lane :test_only_frameworks do |options|
        frameworks = Framework.all

        folders = options[:folders].split(',').filter { |f| !["fastlane", "scripts", "carthage"].include?(f) }
        matching_frameworks = folders.map { |folder| frameworks[folder] }

        framework_schemes = matching_frameworks.map { |f| f.scheme }
        begin
            run_tests_frameworks(framework_schemes, options)
        rescue => e
            UI.test_failure!("Failing running tests #{e.to_s}")
        end
    end

    desc "Generate env config for UI Tests"
    lane :generate_env do
        sh "cd .. && op inject -i wire-ios/WireUITests/env.xcconfig.tpl -o wire-ios/WireUITests/env.xcconfig"
    end

    desc "Run UITests"
    lane :run_uitests do |options|
        schemes = ["WireUITests"]
        options[:testplan] = "UITests"
        options[:number_of_retries] = 0 # no retries
        options[:uitest_shards] = (options[:uitest_shards] || ENV['UITEST_SHARDS'] || 2).to_i
        options[:uitest_shards] = 1 if options[:uitest_shards] < 1
        begin
            run_tests_frameworks(schemes, options)
        rescue => e
            device_id = ENV['IOS_SIM_ID'].to_s.lines.first.to_s.strip
            begin
                if device_id.empty?
                    UI.important("Skipping app log zip after UITest failure: IOS_SIM_ID is missing")
                else
                    sh "../scripts/zip_logs.sh 'com.wearezeta.zclient.alpha' 'group.com.wearezeta.zclient.alpha' 'app-group.zip' '#{device_id}'"
                end
            rescue => zip_error
                UI.important("Skipping app log zip after UITest failure: #{zip_error}")
            end
            UI.test_failure!("Failing running tests #{e.to_s}")
        end
    end

    desc "List all Testiny test cases"
    lane :list_testiny_cases do
        UI.message("🔎 Listing Testiny test case references")
        sh "cd .. && grep -Rn \"testiny:\" . "
    end


    desc "Test one framework only"
    lane :select_framework do |options|
        frameworks = Framework.all.values

        if (!options[:scheme].nil?)
            selected_choice = options[:scheme]
        else
            framework_options = frameworks.map { |f| f.scheme }
            selected_choice = UI.select("Select a framework for testing:", framework_options)
        end

        framework = frameworks.find { |framework| framework.scheme == selected_choice }

        run_tests_frameworks([framework.scheme], options)
    end
    
    lane :select_frameworks do |options|
        frameworks = Framework.all.values
        select_all = "All"  
        framework_options = frameworks.map { |f| f.scheme } + [select_all]
    
        selected_choice = UI.select("Select a framework for testing:", framework_options)
        if selected_choice == select_all 
            test_frameworks(all: "true")
        else 
            framework = frameworks.find { |framework| framework.scheme == selected_choice }

            test_frameworks(folders: framework.name)
        end
    end

    desc "Generate list of frameworks' schemes to test from folders"
    lane :generate_framework_schemes do |options|
        frameworks = Framework.all      

        folders = options[:folders].split(',').filter { |f| !["fastlane", "scripts", "carthage"].include?(f) }
        matching_frameworks = folders.map { |folder| frameworks[folder] }
        
        unique_schemes = matching_frameworks.compact.map do |framework|
            framework.schemes
        end.flatten.uniq

        unique_schemes
    end
    
    desc "Output JSON array of framework matrix entries to test (used by parallel CI jobs)"
    lane :list_schemes_json do |options|
        if options[:all]
            schemes = Framework.all.values.map { |f| f.scheme }.uniq
        elsif options[:test_dependencies]
            schemes = generate_framework_schemes(folders: options[:folders])
        else
            frameworks = Framework.all
            folders = options[:folders].to_s.split(',').reject { |f| ["fastlane", "scripts", "carthage"].include?(f) }
            schemes = folders.map { |folder| frameworks[folder] }.compact.map { |f| f.scheme }.uniq
        end

        all_frameworks = Framework.all.values
        matrix_entries = schemes.map do |scheme_name|
            fw = all_frameworks.find { |f| f.scheme == scheme_name }
            { scheme: scheme_name, needs_lfs: fw&.needs_lfs || false }
        end
        File.write("/tmp/schemes.json", matrix_entries.to_json)
    end

    desc "Prepare for tests"
    lane :prepare_for_tests do
        create_simulator_if_needed
    end

