    def run_tests_frameworks(schemas, options)
        ensure_xcode_version
        # hardcoded values that are required - not meaningful for testing
        options[:build_type] = "Development"
        options[:build_number] = 1
        build = Build.new(options: options)

        write_tests_info_to_summary("🤖 Testing schemas: #{schemas.join(', ')}")

        testplan = options[:testplan] || "AllTests" # TODO: [WPB-17497] GermanLocaleTests are not run

        is_nightly_build = options[:all] == true

        schema_errors = {}

        schemas.each do |scheme|
            write_tests_info_to_summary("🤖 Testing scheme #{scheme} with plan #{testplan}")
            begin
                test_plan(build, scheme, testplan, options)
                schema_errors[scheme] = false
            rescue => e
                write_tests_info_to_summary("❌ Scheme: #{scheme} failed with errors: #{e.to_s}")
                if !is_nightly_build
                    raise e
                end
                schema_errors[scheme] = true
            end
        end

        # report errors so Github action fails
        if schema_errors.values.include?(true)
            raise "Tests fail"
        end
    end

 
    def build_and_upload_app(options)
        ensure_xcode_version
        options[:build_number] = generate_build_number
        prepare_for_release(options)
        build = Build.new(options: options)
        write_build_info_to_summary(build)
        if !build.skip_security_tests
            UI.message "🤖 Run security tests"
            create_simulator_if_needed
            security_plans(options)
        end

        if options[:produce_debug_builds] || false
            UI.message "🤖 Build for simulator"
            build_for_release(options.merge({:configuration => "Debug", :for_simulator => true}))
        end

        produce_release_builds = options[:skip_release_builds].nil? || options[:skip_release_builds] != true
        if produce_release_builds
            UI.message "🤖 Build for release"
            build_for_release(options)
        end

        UI.message "🤖 Upload"
        if options[:upload_app_store] || false
            upload_app_store(options)
        end
        if options[:upload_testflight] || false
            upload_testflight(options)
        end
        sha256(options)
        upload_s3(options)
        save_changelog_to_env(options)
    end

    def save_app_name(name)
        `echo APP_NAME=#{name} >> ./.post_build/.env`
    end

    def download_distribution_certificate_and_profiles(build, options)
        if is_running_on_ci 
            match(
                git_url: "https://#{ENV['WIRE_INTERNAL_GITHUB_USER']}:#{ENV['WIRE_INTERNAL_GITHUB_TOKEN']}@github.com/wireapp/wire-ios-certificates.git",
                readonly: true,
                type: "appstore",
                skip_provisioning_profiles: true,
                app_identifier: []
            )
        else
            match(
                readonly: true,
                type: "appstore",
                skip_provisioning_profiles: true,
                app_identifier: []
            )
        end

        app_bundle_id = get_xcconfig_value(
            path: './wire-ios/Configuration/Release.xcconfig',
            name: 'WIRE_BUNDLE_ID'
        )

        UI.message("downloading provisioning profiles for bundle id: #{app_bundle_id}")
        
        sigh(
            adhoc: build.should_sigh_adhoc,
            readonly: true,
            api_key_path: appstoreconnect_api_key_file_path,
            app_identifier: app_bundle_id
        )
        sigh(
            adhoc: build.should_sigh_adhoc,
            readonly: true,
            api_key_path: appstoreconnect_api_key_file_path,
            app_identifier: "#{app_bundle_id}.extension-share"
        )
        sigh(
            adhoc: build.should_sigh_adhoc,
            readonly: true,
            api_key_path: appstoreconnect_api_key_file_path,
            app_identifier: "#{app_bundle_id}.extension-notification"
        )
    end

    def generate_build_number
        build_number = `curl -H "Accept: text/plain" -X POST -d '' "https://incrementator.appspot.com/api/v1/code/ORUHILeMbXB4D5Z5conFzYoYpQPjVnyUA4pu56X2MHVJSFxM/increment"`
        `echo BUILD_NUMBER=#{build_number} >> ./.post_build/.env`
        build_number
    end

    def write_build_info_to_summary(build)
        summary_file = ENV['GITHUB_STEP_SUMMARY']

        if summary_file.nil? || summary_file.empty?
          UI.error("GITHUB_STEP_SUMMARY is not set. Are you running in GitHub Actions?")
          return
        end

        File.open(summary_file, "a") do |file|
          file.puts "## Fastlane Summary"
          file.puts "- 🛠️ Version: '#{build.extra_info}'"
        end
      
        UI.message("Successfully wrote to GITHUB_STEP_SUMMARY.")
    end

    def write_tests_info_to_summary(text)
        if is_running_on_ci
            summary_file = ENV['GITHUB_STEP_SUMMARY']
        else
            summary_file = "github_summary.md"
        end

        if (summary_file.nil? || summary_file.empty?)
          UI.error("GITHUB_STEP_SUMMARY is not set. Are you running in GitHub Actions?")
          return
        end

        UI.message(text)
        File.open(summary_file, "a") do |file|
          file.puts "#{text}"
        end
    end

    # Fetch dependencies and prepare for building a release
    def prepare_for_release(options)
        xcode_version = options[:xcode_version]

        build_type = options[:build_type]
        # Delete configurations in case we switch to different branch or repo
        sh "rm -rf ../Configuration"
        if build_type.nil? 
            sh "cd .. && ./setup.sh"
        else
            override_folder = options[:override_folder]
            if override_folder.nil? 
                override_folder = "Cloud"
            end

            build = Build.new(options: options)

            `echo BUILD_VERSION=#{build.version_from_xcconfig} >> ./.post_build/.env`

            sh "cd .. && ./setup.sh -o \'./wire-ios-build-assets/#{override_folder}/#{build_type}\'"
            # Adding extra information to the icon must be done after we check them out in setup script
            build.process_icon()

            download_distribution_certificate_and_profiles(build, options)
        end
    end

    # Build for release to AppStore or App Center/S3
    def build_for_release(options)
        build = Build.new(options: options)
        export_method = options[:export_method] || build.export_method

        if build.for_simulator
            Dir.chdir("..") do
                # Build the app for simulator
                sh "xcodebuild " \
                   "-workspace 'wire-ios-mono.xcworkspace' " \
                   "-scheme 'Wire-iOS' " \
                   "-configuration 'Debug' " \
                   "-destination \"generic/platform=iOS Simulator\" " \
                   "-derivedDataPath DerivedData " \
                   "-quiet build " \
                   "BUILD_NUMBER=#{build.build_number}"

                # make a "fake" .ipa package that QA will use for installing to simulator
                sh "mkdir -p debug/Payload"
                sh "mkdir -p #{build.artifact_path(with_filename: false)}"
                sh "cp -r DerivedData/Build/Products/Debug-iphonesimulator/*.app debug/Payload/"
                sh "cd debug && zip -r ../#{build.artifact_path(with_filename: true)}.ipa Payload/"
            end
        else
            enable_countly_args = [
                "COUNTLY_APP_KEY=#{build.countly_api_key}",
            ]

            # DataDog values needs to go through WireCommonComponents
            enable_datadog_args = [
                "DATADOG_APP_ID=#{ENV['DATADOG_APP_ID']}",
                "DATADOG_CLIENT_TOKEN=#{ENV['DATADOG_CLIENT_TOKEN']}",
            ]

            xcargs = ["BUILD_NUMBER=#{build.build_number}"]
            xcargs += enable_datadog_args if build.enable_datadog
            xcargs += enable_countly_args if build.enable_countly

            sh "echo $HAS_PACKAGES_CACHE_HIT"
            build_app(
                scheme: "Wire-iOS",
                configuration: build.configuration,
                export_method: export_method,
                export_options: {"iCloudContainerEnvironment": "Production"},
                derived_data_path: "DerivedData",
                suppress_xcode_output: true,
                silent: true,
                archive_path: build.archive_path(with_filename: true),
                buildlog_path: build.build_path,
                output_directory: build.artifact_path(with_filename: false),
                output_name: build.filename,
                include_bitcode: false,
                include_symbols: true,
                xcargs: xcargs.join(' '),
                cloned_source_packages_path: ENV['PACKAGES_DIR'],
                disable_package_automatic_updates: true,
                skip_package_dependencies_resolution: ENV["HAS_PACKAGES_CACHE_HIT"]
            )
        end
    end

    # Run security plans
    def security_plans(options)
        build = Build.new(options: options)
      
        for scheme in ["Wire-iOS", "WireDataModel", "WireSyncEngine"] do
            test_plan(build, scheme, "SecurityTests", options)
        end
    end

    def test_plan(build, scheme, testplan, options = {})
        ci_args = is_running_on_ci ? "CI=1" : nil

        if scheme == "WireUITests"
            uitest_shards = (options[:uitest_shards] || ENV['UITEST_SHARDS'] || 2).to_i
            uitest_shards = 1 if uitest_shards < 1
            if uitest_shards > 1
                run_sharded_wire_uitests(build, testplan, uitest_shards, ci_args)
                return
            end
        end

        if ENV['IOS_SIM_ID'].nil?
            create_simulator_if_needed
        end

        if ENV['IOS_SIM_ID'].nil?
            UI.user_error! "missing id for tests"
        end

        test_options = {
            step_name: "🧪 Running tests for scheme: #{scheme}",
            testplan: testplan,
            scheme: scheme,
            skip_detect_devices: true,
            configuration: "Debug",
            sdk: "iphonesimulator",
            destination: "platform=iOS Simulator,id=#{ENV['IOS_SIM_ID']},OS=#{ios_version}",
            # code_coverage: true,
            derived_data_path: "DerivedData",
            buildlog_path: build.build_path,
            result_bundle: true,
            # suppress_xcode_output: true,
            output_directory: "#{build.artifact_path(with_filename: false)}/tests/#{scheme}",
            output_types: "junit",
            cloned_source_packages_path: ENV['PACKAGES_DIR'],
            disable_package_automatic_updates: true,
            skip_package_dependencies_resolution: true,
            number_of_retries: build.number_of_retries,
            xcargs: ci_args
        }

        run_tests(test_options)
    end

    def run_sharded_wire_uitests(build, testplan, requested_shards, ci_args)
        write_tests_info_to_summary("🤖 Running WireUITests with #{requested_shards} explicit shards")

        clean_sharded_wire_uitest_outputs(build)
        simulators = create_simulators_for_shards(requested_shards)
        build_wire_uitests_for_testing(build, testplan, simulators.first, ci_args)

        test_identifiers = enumerate_wire_uitests(build, testplan, simulators.first, ci_args)
        if test_identifiers.empty?
            UI.user_error!("No WireUITests were enumerated for sharding")
        end

        shard_count = [requested_shards, test_identifiers.count].min
        if shard_count < requested_shards
            write_tests_info_to_summary("🤖 Reduced WireUITests shard count to #{shard_count} because only #{test_identifiers.count} test(s) were found")
            simulators = simulators.first(shard_count)
        end

        shards = split_tests_for_shards(test_identifiers, shard_count)
        write_shard_assignments(build, shards)
        shard_run = run_wire_uitest_shards(build, testplan, simulators, shards, ci_args)
        merge_sharded_wire_uitest_results(build, shard_run[:outputs])

        unless shard_run[:errors].empty?
            raise shard_run[:errors].first
        end
    end

    def clean_sharded_wire_uitest_outputs(build)
        artifact_output_directory = "#{build.artifact_path(with_filename: false)}/tests/WireUITests"
        shard_output_directory = "#{build.build_path}/WireUITests-shards"

        in_repo_root do
            FileUtils.rm_rf(shard_output_directory)
            FileUtils.rm_rf("#{artifact_output_directory}/WireUITests.xcresult")
            FileUtils.rm_f("#{artifact_output_directory}/WireUITests.junit")
            FileUtils.rm_f("#{artifact_output_directory}/test-enumeration.json")
            FileUtils.rm_rf("#{artifact_output_directory}/shard-assignments")
            Dir.glob("#{artifact_output_directory}/shard-[0-9]*").each do |path|
                FileUtils.rm_rf(path)
            end
        end
    end

    def build_wire_uitests_for_testing(build, testplan, simulator_id, ci_args)
        write_tests_info_to_summary("🤖 Building WireUITests once for sharded execution")

        run_tests(
            step_name: "🧪 Building WireUITests for sharded execution",
            testplan: testplan,
            scheme: "WireUITests",
            skip_detect_devices: true,
            configuration: "Debug",
            sdk: "iphonesimulator",
            destination: "platform=iOS Simulator,id=#{simulator_id},OS=#{ios_version}",
            derived_data_path: "DerivedData",
            buildlog_path: build.build_path,
            cloned_source_packages_path: ENV['PACKAGES_DIR'],
            disable_package_automatic_updates: true,
            skip_package_dependencies_resolution: true,
            xcargs: ci_args,
            build_for_testing: true
        )
    end

    def enumerate_wire_uitests(build, testplan, simulator_id, ci_args)
        enumeration_path = "#{build.artifact_path(with_filename: false)}/tests/WireUITests/test-enumeration.json"
        in_repo_root do
            FileUtils.mkdir_p(File.dirname(enumeration_path))
            FileUtils.rm_f(enumeration_path)
        end

        command = xcodebuild_wire_uitests_command(
            testplan: testplan,
            simulator_id: simulator_id,
            result_bundle_path: nil,
            ci_args: ci_args
        ) + [
            "-enumerate-tests",
            "-test-enumeration-format", "json",
            "-test-enumeration-output-path", enumeration_path,
            "test-without-building"
        ]

        run_logged_command(
            command,
            "#{build.build_path}/Wire-WireUITests-enumerate.log"
        )

        in_repo_root do
            unless File.exist?(enumeration_path)
                UI.user_error!("Expected test enumeration file was not created: #{enumeration_path}")
            end

            identifiers = []
            collect_wire_uitest_identifiers(JSON.parse(File.read(enumeration_path)), identifiers)
            identifiers.uniq.sort
        end
    end

    def collect_wire_uitest_identifiers(value, identifiers, target_name = nil, class_name = nil)
        case value
        when Hash
            kind = value["kind"]
            name = value["name"].to_s
            current_target_name = kind == "target" && !name.empty? ? name : target_name
            current_class_name = kind == "class" && !name.empty? ? name : class_name

            if kind == "test" && !value["disabled"] && !name.empty? && current_class_name
                test_name = name.gsub(/\(\)\z/, "")
                normalized = normalize_wire_uitest_identifier("#{current_target_name || "WireUITests"}/#{current_class_name}/#{test_name}")
                identifiers << normalized if normalized
            end

            Array(value["values"]).each do |child|
                collect_wire_uitest_identifiers(child, identifiers, current_target_name, current_class_name)
            end
            Array(value["children"]).each do |child|
                collect_wire_uitest_identifiers(child, identifiers, current_target_name, current_class_name)
            end
        when Array
            value.each { |child| collect_wire_uitest_identifiers(child, identifiers, target_name, class_name) }
        when String
            normalized = normalize_wire_uitest_identifier(value)
            identifiers << normalized if normalized
        end
    end

    def normalize_wire_uitest_identifier(identifier)
        value = identifier.gsub(/\(\)\z/, "")
        value = value.sub(/\AWireUITests\.xctest\//, "WireUITests/")
        value = value.sub(/\AWireUITests\.xctest\./, "WireUITests/")
        value = value.sub(/\AWireUITests\./, "WireUITests/")
        value = value.sub(/\A.*\/WireUITests\//, "WireUITests/")

        return nil unless value.start_with?("WireUITests/")
        return nil unless value.include?("/test")

        value
    end

    def split_tests_for_shards(test_identifiers, shard_count)
        base_size = test_identifiers.count / shard_count
        remainder = test_identifiers.count % shard_count
        cursor = 0

        (0...shard_count).map do |index|
            shard_size = base_size + (index < remainder ? 1 : 0)
            shard = test_identifiers[cursor, shard_size]
            cursor += shard_size
            shard
        end
    end

    def write_shard_assignments(build, shards)
        assignments_dir = "#{build.artifact_path(with_filename: false)}/tests/WireUITests/shard-assignments"
        in_repo_root do
            FileUtils.mkdir_p(assignments_dir)

            shards.each_with_index do |tests, index|
                shard_number = index + 1
                path = "#{assignments_dir}/shard-#{shard_number}.txt"
                File.write(path, tests.join("\n") + "\n")
            end
        end

        shards.each_with_index do |tests, index|
            shard_number = index + 1
            path = "#{assignments_dir}/shard-#{shard_number}.txt"
            write_tests_info_to_summary("🤖 WireUITests shard #{shard_number}: #{tests.count} test(s)")
            UI.message("WireUITests shard #{shard_number} assignment written to #{path}")
        end
    end

    def run_wire_uitest_shards(build, testplan, simulators, shards, ci_args)
        errors = []
        errors_mutex = Mutex.new
        shard_outputs = Array.new(shards.count)

        threads = shards.each_with_index.map do |tests, index|
            Thread.new do
                shard_number = index + 1
                paths = wire_uitest_shard_paths(build, shard_number)
                shard_outputs[index] = paths
                begin
                    run_wire_uitest_shard(
                        build: build,
                        testplan: testplan,
                        simulator_id: simulators[index],
                        shard_number: shard_number,
                        tests: tests,
                        ci_args: ci_args,
                        paths: paths
                    )
                rescue => e
                    errors_mutex.synchronize { errors << e }
                end
            end
        end

        threads.each(&:join)

        {
            outputs: shard_outputs.compact,
            errors: errors
        }
    end

    def wire_uitest_shard_paths(build, shard_number)
        output_directory = "#{build.build_path}/WireUITests-shards/shard-#{shard_number}"
        {
            shard_number: shard_number,
            output_directory: output_directory,
            result_bundle_path: "#{output_directory}/WireUITests-shard-#{shard_number}.xcresult",
            junit_path: "#{output_directory}/WireUITests-shard-#{shard_number}.junit",
            log_path: "#{build.build_path}/Wire-WireUITests-shard-#{shard_number}.log"
        }
    end

    def run_wire_uitest_shard(build:, testplan:, simulator_id:, shard_number:, tests:, ci_args:, paths:)
        FileUtils.mkdir_p(repo_path(paths[:output_directory]))
        FileUtils.rm_rf(repo_path(paths[:result_bundle_path]))
        FileUtils.rm_f(repo_path(paths[:junit_path]))

        command = xcodebuild_wire_uitests_command(
            testplan: testplan,
            simulator_id: simulator_id,
            result_bundle_path: paths[:result_bundle_path],
            ci_args: ci_args
        )

        tests.each do |test_identifier|
            command << "-only-testing:#{test_identifier}"
        end

        command += [
            "-parallel-testing-enabled", "NO",
            "test-without-building"
        ]

        UI.message("Starting WireUITests shard #{shard_number} on simulator #{simulator_id}")
        run_logged_command(command, paths[:log_path], junit_path: paths[:junit_path])
        UI.success("WireUITests shard #{shard_number} finished")
    end

    def merge_sharded_wire_uitest_results(build, shard_outputs)
        result_paths = in_repo_root do
            shard_outputs.map { |paths| paths[:result_bundle_path] }.select { |path| File.directory?(path) }.map { |path| repo_path(path) }
        end
        if result_paths.empty?
            UI.important("No WireUITests shard xcresult bundles were produced to merge")
            return
        end

        output_directory = "#{build.artifact_path(with_filename: false)}/tests/WireUITests"
        merged_result_path = "#{output_directory}/WireUITests.xcresult"
        absolute_merged_result_path = repo_path(merged_result_path)

        in_repo_root do
            FileUtils.mkdir_p(output_directory)
            FileUtils.rm_rf(absolute_merged_result_path)

            if result_paths.count == 1
                FileUtils.cp_r(result_paths.first, absolute_merged_result_path)
            else
                command = ["xcrun", "xcresulttool", "merge", "--output-path", absolute_merged_result_path] + result_paths
                run_logged_command(command, "#{build.build_path}/Wire-WireUITests-merge.log")
            end
        end

        UI.success("Merged WireUITests shard results into #{merged_result_path}")
    end

    def xcodebuild_wire_uitests_command(testplan:, simulator_id:, result_bundle_path:, ci_args:)
        command = [
            "xcodebuild",
            "-workspace", "./wire-ios-mono.xcworkspace",
            "-scheme", "WireUITests",
            "-configuration", "Debug",
            "-derivedDataPath", "DerivedData",
            "-disableAutomaticPackageResolution",
            "-sdk", "iphonesimulator",
            "-destination", "platform=iOS Simulator,id=#{simulator_id},OS=#{ios_version}",
            "-testPlan", testplan
        ]

        command += ["-clonedSourcePackagesDirPath", ENV['PACKAGES_DIR']] if ENV['PACKAGES_DIR']
        command += ["-resultBundlePath", result_bundle_path] if result_bundle_path
        command << ci_args if ci_args
        command
    end

    def run_logged_command(command, log_path, junit_path: nil)
        success = false

        FileUtils.mkdir_p(repo_path(File.dirname(log_path)))
        FileUtils.rm_f(repo_path(log_path))

        if junit_path
            FileUtils.mkdir_p(repo_path(File.dirname(junit_path)))
            FileUtils.rm_f(repo_path(junit_path))
        end

        shell_command = if junit_path
            "#{command.shelljoin} 2>&1 | tee #{log_path.shellescape} | bundle exec xcpretty --report junit --output #{junit_path.shellescape}"
        else
            "#{command.shelljoin} > #{log_path.shellescape} 2>&1"
        end

        UI.command(shell_command)
        success = if junit_path
            system("bash", "-o", "pipefail", "-c", shell_command, chdir: repo_root_path)
        else
            system(shell_command, chdir: repo_root_path)
        end

        return if success

        raise "Command failed. See #{log_path}"
    end

    def repo_root_path
        current_path = Dir.pwd
        File.basename(current_path) == "fastlane" ? File.expand_path("..", current_path) : current_path
    end

    def repo_path(path)
        path.start_with?("/") ? path : File.join(repo_root_path, path)
    end

    def in_repo_root(&block)
        if File.basename(Dir.pwd) == "fastlane"
            Dir.chdir("..", &block)
        else
            yield
        end
    end

    def create_simulators_for_shards(shard_count)
        simulators = []

        (1..shard_count).each do |shard_number|
            simulator_name = "#{iPhoneNameForTesting} WireUITests Shard #{shard_number} - iOS#{ios_version}"
            simulator_id = create_or_reset_simulator(simulator_name)
            simulators << simulator_id
        end

        ENV['IOS_SIM_ID'] = simulators.first
        boot_simulators_for_shards(simulators)
        seed_simulators_media(simulators)
        simulators
    end

    def boot_simulators_for_shards(simulators)
        UI.message("Booting #{simulators.count} WireUITests shard simulator(s)")
        run_simulator_tasks(simulators, "boot") do |simulator_id|
            system("xcrun", "simctl", "boot", simulator_id, out: File::NULL, err: File::NULL)
            unless system("xcrun", "simctl", "bootstatus", simulator_id, "-b")
                raise "Failed waiting for simulator #{simulator_id} to boot"
            end
        end
    end

    def seed_simulators_media(simulators)
        UI.message("Seeding media on #{simulators.count} WireUITests shard simulator(s)")
        run_simulator_tasks(simulators, "seed media") do |simulator_id|
            seed_simulator_media(simulator_id)
        end
    end

    def run_simulator_tasks(simulators, task_name)
        errors = []
        errors_mutex = Mutex.new

        threads = simulators.map do |simulator_id|
            Thread.new do
                yield simulator_id
            rescue => e
                errors_mutex.synchronize { errors << e }
            end
        end

        threads.each(&:join)
        UI.user_error!("Failed to #{task_name} shard simulator: #{errors.first}") unless errors.empty?
    end

    def create_or_reset_simulator(simulator_name)
        existing_simulator = simulator_id(named: simulator_name)

        if existing_simulator.empty?
            UI.message "create simulator #{simulator_name}"
            simulator_id = `xcrun simctl create #{Shellwords.escape(simulator_name)} #{Shellwords.escape(iPhoneNameForTesting)} #{Shellwords.escape("iOS#{ios_version}")}`.strip
            UI.user_error!("Failed to create simulator #{simulator_name}") if simulator_id.empty?
            simulator_id
        else
            UI.message "clear simulator content for #{existing_simulator}"
            system("xcrun", "simctl", "shutdown", existing_simulator, out: File::NULL, err: File::NULL)
            unless system("xcrun", "simctl", "erase", existing_simulator)
                UI.user_error!("Failed to erase simulator #{existing_simulator}")
            end
            existing_simulator
        end
    end

    def simulator_id(named:)
        devices = JSON.parse(`xcrun simctl list devices available --json`)
        devices.fetch("devices").each_value do |runtime_devices|
            matching_device = runtime_devices.find { |device| device["name"] == named }
            return matching_device["udid"] if matching_device
        end
        ""
    end

    def seed_simulator_media(simulator_id)
        env = {
            "IOS_SIM_ID" => simulator_id,
            "REPO_ROOT" => repo_root_path
        }
        unless system(env, repo_path("scripts/seed-simulator-media.sh"), chdir: repo_root_path)
            raise "Failed to seed simulator media for #{simulator_id}"
        end
    end

    def create_simulator_if_needed
        devices = `xcrun simctl list`
        UI.message("Available simulators:\n#{devices}")
        simulator_name = "#{iPhoneNameForTesting} - iOS#{ios_version}"

        existing_simulator = simulator_id(named: simulator_name)

        if existing_simulator.empty?
            UI.message "create simulator #{simulator_name}"
            existing_simulator = `xcrun simctl create #{Shellwords.escape(simulator_name)} #{Shellwords.escape(iPhoneNameForTesting)} #{Shellwords.escape("iOS#{ios_version}")}`.strip
        else
            UI.message "clear simulator content for #{existing_simulator}"
            system("xcrun", "simctl", "shutdown", existing_simulator, out: File::NULL, err: File::NULL)
            unless system("xcrun", "simctl", "erase", existing_simulator)
                UI.user_error!("Failed to erase simulator #{existing_simulator}")
            end
        end
        ENV['IOS_SIM_ID'] = existing_simulator

        if ENV['GITHUB_ENV']
            sh "echo IOS_SIM_ID=#{ENV['IOS_SIM_ID']} >> #{ENV['GITHUB_ENV']}"
        end
        sh "../scripts/seed-simulator-media.sh"
    end
    
    # Upload to AppStore
    def upload_app_store(options)
        build = Build.new(options: options)
        sh "cp ../wire-ios/Configuration/Appfile ."

        deliver(
            api_key_path: appstoreconnect_api_key_file_path,
            ipa: "#{build.artifact_path(with_filename: true)}.ipa",
            submit_for_review: false,
            automatic_release: false,
            force: true, # Skip HTML report verification
            skip_binary_upload: false,
            run_precheck_before_submit: false,
            precheck_include_in_app_purchases: false,
            skip_app_version_update: true,
            skip_metadata: true,
            skip_screenshots: true
        )
    end

    # Upload to TestFlight
    def upload_testflight(options)
        build = Build.new(options: options)
        sh "cp ../wire-ios/Configuration/Appfile ."
        
        # we add this group to get a review from Apple when we upload new build version
        # in order to speed up distribution to real external groups
        groups = ["Default External Testers"]
        if build.send_to_externals
            groups += options[:extra_distribution_groups]
        end

        upload_to_testflight(
            api_key_path: appstoreconnect_api_key_file_path,
            ipa: "#{build.artifact_path(with_filename: true)}.ipa",
            skip_waiting_for_build_processing: false,
            distribute_external: true,
            groups: groups,
            submit_beta_review: true,
            changelog: changelog(build)
        )
    end

    # Changelog for current build
    def changelog(build)
        changelog = ""
        changelog_path = './../CHANGELOG.md'

        if build.playground_build 
            changelog += "Playground build for #{build.git_branch}\n\n"
        end

        if !build.development_build && File.exist?(changelog_path)
            changelog += File.read(changelog_path)
        else 
            changelog += "**Last commits:**\n" + changelog_from_git_commits(
                    commits_count: 5,
                    pretty: "- %s by %ae",
            )
        end
        changelog
    end

    # "Calculate sha256 ipa"
    def sha256(options)
        build = Build.new(options: options)
       
        # Calculate SHA-256 for the local IPA file
        ipa_path = "../#{build.artifact_path(with_filename: true)}.ipa"
        sha256 = `shasum -a 256 #{ipa_path} | awk '{print $1}'`.strip
        UI.message("SHA-256 of IPA is: #{sha256}")

        # Export SHA-256 and INSTALL_LINK to .post_build/.env file
        export_env_path = "./.post_build/.env"
        FileUtils.mkdir_p("./.post_build")

        sh "export TEMP='BUILD_SHA256=#{sha256}' && echo $TEMP >> #{export_env_path}"
    end

    # Upload to S3 (Automation builds)
    def upload_s3(options)
        build = Build.new(options: options)
        s3_subfolder = options[:s3_subfolder]

        if s3_subfolder.nil? 
            s3_path = "s3://#{ENV['S3_BUCKET']}/ios/"
            sh "echo upload to s3 default folder "
        else 
            s3_path = "s3://#{ENV['S3_BUCKET']}/ios/#{s3_subfolder}/"
            sh "echo upload to s3 subfolder: #{s3_subfolder}"
        end


        output = ""
        if build.appstore_build
            output += `cd ../#{build.archive_path(with_filename: false)} && tar -czf #{build.filename}.xcarchive.tgz #{build.filename}.xcarchive`
        end
        
        output += `cd .. && aws s3 cp --recursive --exclude '*'  --include '*.ipa'  --include '*.app.dSYM.zip' --include '*.xcarchive.tgz' --include '*.junit' artifacts/ #{s3_path}`
        paths = output.split(/[\r,\n]/).map { |line| line.gsub(/\n/, '').gsub(/\*/, '').match(/s3:\/\/.*ipa$/)}.compact!.map{ |match| match[0] }.uniq.join(' ')
        `export TEMP='S3_PATHS=#{Base64.strict_encode64(paths)}' && echo $TEMP >> ./.post_build/.env`
    end

    def save_changelog_to_env(options)
        build = Build.new(options: options)
        changelog = changelog(build)
        `export TEMP='RELEASE_NOTES=#{Base64.strict_encode64(changelog)}' && echo $TEMP >> ./.post_build/.env`
    end
end

class Build
    attr_reader :build_type
    attr_reader :git_branch
    attr_reader :build_number
    attr_reader :for_simulator
    attr_reader :configuration
    attr_reader :enable_datadog
    attr_reader :skip_security_tests
    # send to non-default external distribution list
    attr_reader :send_to_externals
    attr_reader :countly_api_key
    attr_reader :enable_countly
    attr_reader :number_of_retries
    
    def initialize(options:)
        build_number = options[:build_number]
        if build_number.nil?
            UI.user_error! "Pass build_number parameter to fastlane e.g. fastlane build build_number:1234"
        end
        build_type = options[:build_type]
        if build_type.nil? 
            UI.user_error! "Pass build_type parameter, e.g. fastlane build build_type:Development"
        end


        @build_type = build_type
        if ENV['GITHUB_REF_NAME'].nil? 
            @git_branch = %x(git rev-parse --abbrev-ref HEAD).chomp
        else
            @git_branch = ENV['GITHUB_REF_NAME']
        end

        @countly_api_key = options[:countly_api_key]
        @enable_countly = ENV['ENABLE_COUNTLY'] == "true" || ENV['ENABLE_COUNTLY'] == "1"
        @send_to_externals = ENV['SEND_TO_EXTERNALS'] == "true" || ENV['SEND_TO_EXTERNALS'] == "1"
        @enable_datadog = ENV['ENABLE_DATADOG'] == "true" || ENV['ENABLE_DATADOG'] == "1"
        @skip_security_tests = ENV['SKIP_SECURITY_TESTS'] == "true" || ENV['SKIP_SECURITY_TESTS'] == "1"
        @build_number = build_number
        @number_of_retries = options[:number_of_retries] || 2
        
        for_simulator = options[:for_simulator]
        if for_simulator.nil? 
            @for_simulator = false
        else
            @for_simulator = for_simulator.to_s == 'true'
        end

        configuration = options[:configuration]
        if configuration.nil? 
            @configuration = "Release"
        else
            @configuration = configuration
        end
        
    end

    # Helpers

    def pr_build?
        !ENV['PR_S3_SUBFOLDER'].nil? 
    end

    def playground_build
        @build_type == "Playground"
    end

    def appstore_build
        @build_type == "AppStore"
    end

    def development_build
        @build_type == "Development"
    end

    def rc_build
        @build_type == "RC"
    end

    def beta_build
        @build_type == "Beta"
    end

    def debug_build
        @configuration == "Debug"
    end

    def normalized_branch_name
        @git_branch.gsub("/", "_")
    end

    def export_method
        if debug_build
            "development"
        elsif appstore_build || beta_build || rc_build || playground_build || development_build
            "app-store"
        else 
            "ad-hoc"
        end
    end

    def should_sigh_adhoc
        !appstore_build && !rc_build && !beta_build && !playground_build && !development_build
    end

    # Paths

    def artifact_path(with_filename: true)
        "artifacts/#{artifact_directory}" + (with_filename ? "/#{filename}" : "")
    end

    def build_path
        "build"
    end

    def archive_path(with_filename: true)
        # Put AppStore archive next to .ipa for futher processing
        if appstore_build
            "artifacts/#{artifact_directory}" + (with_filename ? "/#{filename}" : "")
        else 
            "#{build_path}" + (with_filename ? "/#{filename}" : "")
        end
    end

    def filename
        simulator = @for_simulator ? "-simulator" : ""
        "Wire-#{@build_type.downcase}-#{normalized_branch_name}#{simulator}-#{@build_number}"
    end

    def artifact_directory
        result = ""
        suffix = "" 
        if for_simulator 
            suffix = "simulator" 
        else 
            suffix = "device/" + (debug_build ? "debug" : "release")
        end

        case @build_type
        when "Playground"
            result = "playground-#{normalized_branch_name}/#{suffix}"
        when "Development"
            result = "development/#{suffix}"
        when "AppStore"
            result = "release/appstore"
        when "RC"
            result = "release/#{suffix}"
        when "Beta"
            result = "release/testflight"
        else
            UI.user_error! "Unknown build type: #{@build_type}"
        end

        # We want to group related artifacts by the filename.
        if !pr_build?
            result + "/" + filename
        else
            result + "/PR/" + ENV['PR_S3_SUBFOLDER']
        end
    end

    # Adding build number to icon

    def process_icon
        # No preprocessing needed for AppStore icons
        if appstore_build
            return
        end
        # Loop over all icons in the iconset
        processed = 0
        Dir.glob("../wire-ios/#{iconset_location}/*.png") do |image|
            width = %x( identify -format %w #{image} )
            image_height = %x( identify -format %h #{image} )
            height = Integer(image_height) / 4.0

            # Add build number to the icon
            %x( magick -background '#0008' -fill white -font '/System/Library/Fonts/Helvetica.ttc' -gravity center -size #{width}x#{height} caption:"#{extra_info}" "#{image}" +swap -gravity south -composite "#{image}" )
            processed += 1
        end
        UI.important("Processed #{processed} icons in #{iconset_location} by adding '#{extra_info}'")
    end

    def extra_info
        prefix = ""
        if rc_build
            prefix = "#{version_from_xcconfig}-"
        end

        prefix + @build_number
    end

    def version_from_xcconfig
        IO.foreach('../wire-ios/Wire-iOS/Resources/Configuration/Version.xcconfig').grep(/WIRE_SHORT_VERSION/).first.split(" = ")[1].chomp
    end

    def iconset_location
        "Configuration/Images.xcassets/AppIcon-#{iconset_name}.appiconset"
    end

    def iconset_name
        if debug_build
            "Development" # yellow
        elsif development_build
            "Edge"
        elsif playground_build
            "Development" # yellow
        elsif rc_build
            "Release"
        else
            @build_type
        end
    end
end
